{
  "name": "CS24L Juice Shop Lab",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Juice Shop",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install --quiet pytest",
  "postStartCommand": "docker compose up -d",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
